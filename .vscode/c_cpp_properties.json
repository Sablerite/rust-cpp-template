{
  "configurations": [
    {
      "name": "Windows (MSVC)",
      "intelliSenseMode": "windows-msvc-x64",
      "cppStandard": "c++20",
      "cStandard": "c17",
      // The last two folders appear after the first `cargo build`.
      "includePath": [
        "${workspaceFolder}/crates/ffi",
        "${workspaceFolder}/third_party",
        "${workspaceFolder}/target/cxxbridge",
        "${workspaceFolder}/target/vcpkg/x64-windows-static-md-release/installed/x64-windows-static-md-release/include"
      ]
    }
  ],
  "version": 4
}
