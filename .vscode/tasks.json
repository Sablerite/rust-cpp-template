{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo build",
      "type": "shell",
      "command": "cargo build --workspace",
      "problemMatcher": ["$rustc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "just test",
      "type": "shell",
      "command": "just test",
      "problemMatcher": ["$rustc"],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "just lint",
      "type": "shell",
      "command": "just lint",
      "problemMatcher": ["$rustc"]
    }
  ]
}
