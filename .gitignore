# Build output (Cargo, plus vcpkg packages installed under target/vcpkg)
/target/
/dist/
# vcpkg's default per-project install dir, if vcpkg is ever run by hand here
/vcpkg_installed/
# Generated by `just compdb` for clangd / clang-tidy
/compile_commands.json
/.cache/

# Local secrets and machine-specific settings
.env
.env.*
!.env.example
*.local.toml

# Editors and OS
.vs/
.idea/
*.swp
.DS_Store
Thumbs.db
