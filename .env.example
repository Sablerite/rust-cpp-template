# Copy to .env (git-ignored). `just` loads it for every recipe.

# Log filter: error | warn | info | debug | trace, or per target, e.g. cpp=debug
RUST_LOG=info

# Print a backtrace when Rust panics
RUST_BACKTRACE=1

# Override where app_core::assets looks for files
# APP_ASSETS_DIR=C:\path\to\assets
