# Normalize text files to LF in the repo; Windows scripts keep CRLF on checkout.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never diff or convert. For large files consider Git LFS
# (see assets/README.md).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff2 binary
*.wav binary
*.ogg binary
*.mp3 binary
*.flac binary
*.glb binary
*.zip binary
*.pdf binary
